# 복사해서 .env.local 로 사용하세요 (커밋 금지)

# Better Auth (npx @better-auth/cli secret 또는 openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Gmail) — 리디렉션 URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion OAuth (Public integration) 또는 내부 통합 토큰
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
