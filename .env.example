# 복사해서 .env.local 로 사용하세요 (커밋 금지)

# Gmail IMAP — 2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서 앱 비밀번호 발급
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 앱 접근 비밀번호 (HTTP Basic 인증). 배포 환경에서는 필수, 로컬 개발에서는 비워도 됨
APP_PASSWORD=

# Notion OAuth (Public integration) 또는 내부 통합 토큰
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
